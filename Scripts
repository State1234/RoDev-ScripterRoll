local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local AuraData = require(Remotes:WaitForChild("AuraData"))
local RollEvent = Remotes:WaitForChild("RollEvent")
local StoreAura = Remotes:WaitForChild("StoreAura")
local DeleteAura = Remotes:WaitForChild("DeleteAura")

local GAMEPASS_ID = 1822222320

local function getActiveWeight(data, hasPass)
	local weight = data.Weight or 1
	if hasPass and data.Rarity ~= "Common" then
		return weight * 2
	end
	return weight
end

local function rollAura(hasPass)
	local totalWeight = 0

	for _, data in pairs(AuraData.Auras) do
		totalWeight += getActiveWeight(data, hasPass)
	end

	if totalWeight <= 0 then
		return "plbl_rivals", "Common", "1 in 6"
	end

	local randomValue = math.random(1, totalWeight)
	local current = 0

	for auraName, data in pairs(AuraData.Auras) do
		local weight = getActiveWeight(data, hasPass)
		current += weight

		if randomValue <= current then
			local exactOdds = math.floor((totalWeight / weight) + 0.5)
			local oddsText = "1 in " .. exactOdds
			return auraName, data.Rarity, oddsText
		end
	end

	return "plbl_rivals", "Common", "1 in 6"
end

RollEvent.OnServerInvoke = function(player)
	local hasPass = false

	local success, owned = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_ID)
	end)

	if success and owned then
		hasPass = true
	end

	local aura, rarity, oddsText = rollAura(hasPass)
	return aura, rarity, oddsText
end

StoreAura.OnServerEvent:Connect(function(player, auraName)
	if typeof(auraName) ~= "string" then return end
	if not AuraData.Auras[auraName] then return end

	local inv = player:FindFirstChild("Inventory")
	if not inv then
		inv = Instance.new("Folder")
		inv.Name = "Inventory"
		inv.Parent = player
	end

	local item = inv:FindFirstChild(auraName)
	if not item then
		item = Instance.new("IntValue")
		item.Name = auraName
		item.Value = 1
		item.Parent = inv
	else
		item.Value += 1
	end
end)

DeleteAura.OnServerEvent:Connect(function(player, auraName)
	if typeof(auraName) ~= "string" then return end

	local inv = player:FindFirstChild("Inventory")
	if inv then
		local item = inv:FindFirstChild(auraName)
		if item then
			if item:IsA("IntValue") and item.Value > 1 then
				item.Value -= 1
			else
				item:Destroy()
			end
		end
	end
end) 




