local Hoverui = {
	X = Close,
	openinv = OpenInv,
	kick = kick,
	ban = ban,
	speed = speed,
	jump = jump,
}

local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local originalSizes = {}

for name, button in pairs(Hoverui) do
	originalSizes[button] = button.Size

	local targetSize = UDim2.new(
		originalSizes[button].X.Scale, 
		originalSizes[button].X.Offset * 1.1, 
		originalSizes[button].Y.Scale, 
		originalSizes[button].Y.Offset * 1.1
	)

	button.MouseEnter:Connect(function()
		local tween = TweenService:Create(button, tweenInfo, {Size = targetSize})
		tween:Play()
	end)

	button.MouseLeave:Connect(function()
		local tween = TweenService:Create(button, tweenInfo, {Size = originalSizes[button]})
		tween:Play()
	end)
end

local originalMainSize = Main.Size
local frameOriginalSizes = {
	[KickFrame] = KickFrame.Size,
	[BanFrame] = BanFrame.Size,
	[SpeedFrame] = SpeedFrame.Size,
	[JumpFrame] = JumpFrame.Size,
}

local function animateOpen(frame, textBox)
	sound:Play()
	local ogSize = frameOriginalSizes[frame]

	frame.Size = UDim2.new(0, 0, 0, 0)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	frame.Visible = true

	local tween = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = ogSize
	})
	tween:Play()

	task.delay(0.1, function()
		if textBox then
			textBox:CaptureFocus()
		end
	end)
end

local function animateClose(frame)
	sound:Play()
	local ogSize = frameOriginalSizes[frame]

	local tween = TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 0, 0, 0)
	})
	tween:Play()

	tween.Completed:Connect(function()
		frame.Visible = false
		frame.Size = ogSize
		frame.AnchorPoint = Vector2.new(0, 0)
		frame.Position = UDim2.new(0.5, -ogSize.X.Offset/2, 0.5, -ogSize.Y.Offset/2)
	end)
end

