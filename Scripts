local function parseAndExecute(textBox, frame, commandName)
	sound:Play()
	local text = textBox.Text
	text = string.gsub(text, "^%s*(.-)%s*$", "%1")
	text = string.gsub(text, "^%s*:%a+%s*", "")

	local parts = {}
	for word in string.gmatch(text, "%S+") do
		table.insert(parts, word)
	end

	local arg1 = parts[1]
	local arg2 = parts[2]

	if arg1 then
		AdminCommandEvent:FireServer(commandName, arg1, arg2)
		textBox.Text = "Executed!"
		task.delay(1.5, function()
			textBox.Text = ""
			animateClose(frame)
		end)
	else
		textBox.Text = "Invalid Input!"
		task.delay(1.5, function()
			if textBox.Text == "Invalid Input!" then
				textBox.Text = ""
			end
		end)
	end
end

