 local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local AdminCommandEvent = ReplicatedStorage.Remotes:WaitForChild("AdminCommandEvent")

local function findPlayer(nameString)
	if not nameString then return nil end
	for _, player in ipairs(Players:GetPlayers()) do
		if string.lower(string.sub(player.Name, 1, #nameString)) == string.lower(nameString) then
			return player
		end
	end
	return nil
end

AdminCommandEvent.OnServerEvent:Connect(function(sender, command, targetArg1, targetArg2)
	local targetPlayer
	local value

	if command == "Speed" or command == "Jump" then
		value = targetArg1
		if targetArg2 and targetArg2 ~= "" then
			targetPlayer = findPlayer(targetArg2)
		else
			targetPlayer = sender
		end
	else
		targetPlayer = findPlayer(targetArg1)
	end

	if not targetPlayer then
		AdminCommandEvent:FireClient(sender, false, "Player not found!")
		return
	end

	if command == "Kick" then
		local targetName = targetPlayer.Name
		targetPlayer:Kick("You have been kicked by an administrator.")
		AdminCommandEvent:FireClient(sender, true, "Kicked " .. targetName)

	elseif command == "Ban" then
		local targetName = targetPlayer.Name
		targetPlayer:Kick("You have been banned by an administrator.")
		AdminCommandEvent:FireClient(sender, true, "Banned " .. targetName)

	elseif command == "Speed" then
		local numVal = tonumber(value)
		if numVal and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
			targetPlayer.Character.Humanoid.WalkSpeed = numVal
			AdminCommandEvent:FireClient(sender, true, "Speed set!")
			return
		end
		AdminCommandEvent:FireClient(sender, false, "Invalid speed!")

	elseif command == "Jump" then
		local numVal = tonumber(value)
		if numVal and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
			local humanoid = targetPlayer.Character.Humanoid
			humanoid.JumpHeight = numVal
			AdminCommandEvent:FireClient(sender, true, "Jump set!")
			return
		end
		AdminCommandEvent:FireClient(sender, false, "Invalid jump!")
	end
end)

